# === MV Agendate IA — Configuración ===
# Copiar a .env y completar. Sin claves la plataforma corre en MODO DEMO
# (respuestas simuladas, ideal para mostrar sin costo).
#
# 💡 NO hace falta editar este archivo: podés cargar TODO desde el navegador
#    en  /config.html  (la API key de Claude toma efecto al instante, sin
#    reiniciar). Este .env solo aporta valores por defecto iniciales.

# --- IA (agente conversacional) ---
# Tu API key de Anthropic. También configurable desde /config.html.
ANTHROPIC_API_KEY=

# --- Datos del profesional (también configurables desde /config.html) ---
NOMBRE_PROFESIONAL=
OFICIO_PROFESIONAL=electricista
AGENCIA_NOMBRE=
AGENCIA_TELEFONO=+598 99 000 000
# Jornada laboral y descansos que usa el motor de agenda.
HORARIO_INICIO=08:00
HORARIO_FIN=19:00
ALMUERZO_INICIO=12:30
ALMUERZO_FIN=13:30
DIAS_LIBRES=0

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=mv-agendate-verify

# --- Telefonía (Twilio Voice: llamadas entrantes/salientes) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- ChatVoice premium (ASR streaming + TTS voz clonada) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- CRM (webhook saliente: se dispara con cada cita nueva) ---
# Apuntar a Zapier/Make, Google Sheets, etc.
CRM_WEBHOOK_URL=

# --- Licencias firmadas (el candado del producto) ---
# Clave PRIVADA con la que el servidor de ventas firma las licencias. Se genera
# con  node scripts/licencia-par.js  y va SOLO acá / en Vercel — nunca en el
# repo ni en el instalador. La mitad pública se pega en
# src/store/licencia-clave.js y esa sí se commitea.
# Sin esto, la copia instalada acepta cualquier código como licencia.
MV_LICENSE_PRIVATE_KEY=
# Licencias del formato viejo (MV-PLAN-XXXXXXXX) vendidas ANTES de que
# existiera la firma, separadas por coma. Sin esto quedan afuera.
MV_LICENCIAS_HEREDADAS=

# --- Pagos (MercadoPago) ---
MERCADOPAGO_TOKEN=
# Tipo de cambio UYU por USD, para el cobro recurrente del plan Full (MercadoPago
# no admite cobros recurrentes en USD para cuentas de Uruguay). Default 42.
TIPO_CAMBIO_UYU=

# --- Administración (protege el panel; vacío = abierto solo en local) ---
ADMIN_KEY=
# Secreto que valida el Cron Job de Vercel al llamar /api/agenda/chequear-retrasos
CRON_SECRET=

# --- Servidor ---
PORT=3000
# Dominio público del deploy (para back_urls de MercadoPago)
SITIO_URL=
