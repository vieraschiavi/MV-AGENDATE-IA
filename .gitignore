node_modules/
.env
*.log
/data/
.DS_Store
/dist/
movil/node_modules/
movil/android/
movil/www/
movil/android-apk/build/
movil/*.apk.idsig
# Keystores de firma: son la identidad de la app, NUNCA se versionan. Antes se
# listaban rutas sueltas y android/mv-release.keystore se coló por estar en una
# carpeta que no estaba en la lista; con un patrón general no vuelve a pasar.
*.keystore
*.jks
src/clave-embebida.b64
voces/*.onnx
.vercel
.env*
!.env.example
descargas/*.zip
# Excepción: el paquete PC de PRUEBA sí se versiona (Vercel lo sirve como descarga gratis).
!public/descargas/MV-Agendate-IA-PC.zip
# La APK Android firmada también se versiona (misma razón; ~110 KB).
!public/descargas/MV-Agendate-IA.apk
# Artefactos de compilación de la APK (android/build-apk.sh los regenera).
android/build/
webapp/node_modules/

# Carpeta de trabajo de electron-builder (contiene también el .exe final
# ANTES de copiarlo a public/descargas/ — ver npm run empaquetar-exe).
dist-instalador/

# El instalador final SÍ se versiona en public/descargas/MV-Agendate-IA-Setup.exe
# (~96 MB, entra bajo el límite de 100 MB de GitHub) porque el pipeline que lo
# publicaba aparte (GitHub Release vía .github/workflows/build-windows-exe.yml)
# viene fallando en los 8 intentos hechos hasta ahora — probablemente por un
# gate de facturación de GitHub Actions para runners Windows, algo que solo
# puede resolver el dueño de la cuenta desde Settings → Billing. Mientras tanto,
# /descargar sirve el archivo commiteado directo, sin depender de esa CI.
# Regenerarlo con: npm run empaquetar-exe && cp dist-instalador/MV-Agendate-IA-Setup.exe public/descargas/
public/descargas/MV-Agendate-IA-Windows.zip

# Copia ofuscada de src/+electron/ (ver scripts/ofuscar.js) que se empaqueta
# en el instalador en vez del código fuente real. Se regenera sola antes de
# cada build (npm run empaquetar-exe corre "ofuscar" primero).
dist-protegido/

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/
# Esa regla la reescribe graft en cada build y solo la da por puesta si está
# escrita así, sin barra inicial — o sea que también se lleva puesto cualquier
# directorio "graft" más adentro, incluido el skill que sí va commiteado.
# Anclarla la duplicaba en cada corrida; la excepción hace lo mismo sin pelearse
# con la herramienta, y tiene que quedar DESPUÉS para ganarle.
!.claude/skills/graft/
