{
  "name": "mv-agendate-ia",
  "version": "0.1.0",
  "description": "MV Agendate IA — Chatbot/ChatVoice con IA que atiende clientes de cualquier oficio por WhatsApp o voz: cotiza trabajos predefinidos, agenda citas optimizando traslados y descansos, avisa retrasos automáticamente y ofrece un dashboard con CRM de clientes y facturación.",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/vieraschiavi/mv-agendate-ia.git"
  },
  "author": "MV Agendate IA",
  "scripts": {
    "start": "node src/programa.js",
    "servidor": "node src/server.js",
    "configurar": "node src/setup/configurar.js",
    "embeber-clave": "node src/setup/embeber.js",
    "empaquetar-pc": "bash scripts/empaquetar-pc.sh",
    "ofuscar": "node scripts/ofuscar.js",
    "preempaquetar-exe": "node scripts/ofuscar.js",
    "empaquetar-exe": "electron-builder --win --x64 --publish never",
    "preempaquetar-exe-owner": "node scripts/ofuscar.js --owner",
    "empaquetar-exe-owner": "electron-builder --win --x64 --publish never --config.appId=com.mv.agendateia.owner --config.productName=\"MV Agendate IA (Dueno)\" --config.nsis.artifactName=MV-Agendate-IA-Setup-Dueno.exe --config.nsis.shortcutName=\"MV Agendate IA (Dueno)\" --config.nsis.uninstallDisplayName=\"MV Agendate IA (Dueno)\"",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@upstash/redis": "^1.38.0",
    "botid": "^1.5.11",
    "express": "^4.21.0",
    "ws": "^8.21.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "javascript-obfuscator": "^5.5.0"
  },
  "build": {
    "appId": "com.mv.agendateia",
    "productName": "MV Agendate IA",
    "directories": {
      "output": "dist-instalador"
    },
    "asar": false,
    "files": [
      {
        "from": "dist-protegido/src",
        "to": "src",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-protegido/electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      },
      "public/**/*",
      "!public/video/**",
      "!public/descargas/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/logo-mv.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "public/legales/eula.txt",
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MV Agendate IA",
      "uninstallDisplayName": "MV Agendate IA",
      "artifactName": "MV-Agendate-IA-Setup.exe"
    }
  }
}
